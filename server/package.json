{
  "name": "@ninja/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game server: ngu\u1ed3n s\u1ef1 th\u1eadt c\u1ee7a tr\u00f2 ch\u01a1i (HTTP API, x\u00e1c th\u1ef1c, nh\u00e2n v\u1eadt).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@ninja/shared": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.4",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
