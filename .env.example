# Sao chép thành .env rồi chỉnh giá trị cho môi trường của bạn.
# .env KHÔNG được commit (đã có trong .gitignore).

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200
PROTOCOL_VERSION=1

# --- PostgreSQL ---
DATABASE_URL=postgresql://ninja:ninja_dev_password@localhost:5432/ninja
POSTGRES_USER=ninja
POSTGRES_PASSWORD=ninja_dev_password
POSTGRES_DB=ninja

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Bảo mật (đổi khi triển khai thật) ---
JWT_SECRET=dev-only-do-not-use-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
